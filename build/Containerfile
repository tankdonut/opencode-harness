# syntax=docker/dockerfile:1

# ============================================
# opencoder Container Image
# ============================================
# Version is read from .opencode-version at build time.
# Build: ./scripts/build.sh
# Or with explicit options:
#   ./scripts/build.sh --tag my-tag --runtime docker --no-cache
#
# Labels are applied post-build via scripts/build.sh
# Image tags include OpenCode version for traceability:
#   opencoder:latest  - current default
# ============================================

FROM ghcr.io/tankdonut/tools:latest@sha256:139895413baba947756fb5957c3ed143d61ef095e94de74117179e9a927e3115 AS tools

FROM docker.io/library/ubuntu:26.04

# Build arguments
ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH=amd64
ARG TARGETVARIANT=

SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# Install runtime dependencies
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    nodejs \
    npm \
    python3 \
    python3-pip \
    unzip \
    yq \
    && rm -rf /var/lib/apt/lists/*

# Install bun runtime for oh-my-openagent
# Using npm to install bun globally (cleaner than curl|bash in container)
RUN npm install -g bun@1.3.11

# Copy vendor binaries from tools stage
COPY --exclude=opencode --from=tools /dist/ /vendor/bin/

# Copy version and checksum files (single source of truth for OpenCode installation)
COPY .opencode-version /etc/opencode-version
COPY .opencode-checksums /etc/opencode-checksums

# Download and install OpenCode from GitHub releases
# Version read from /etc/opencode-version (single source of truth)
# This happens at build time for reproducibility
RUN set -eux; \
    OPENCODE_VERSION="$(cat /etc/opencode-version | tr -d '[:space:]')"; \
    \
    # Determine architecture mapping \
    case "$(uname -m)" in \
    x86_64)  OPENCODE_ARCH="x64" ;; \
    aarch64) OPENCODE_ARCH="arm64" ;; \
    *)       OPENCODE_ARCH="x64" ;; \
    esac; \
    \
    # Construct download URL \
    OPENCODE_RELEASE_URL="https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-${OPENCODE_ARCH}.tar.gz"; \
    \
    echo "Downloading OpenCode ${OPENCODE_VERSION} for ${OPENCODE_ARCH}..."; \
    curl -fsSL "${OPENCODE_RELEASE_URL}" -o /tmp/opencode.tar.gz; \
    \
    # Verify download succeeded \
    if [ ! -s /tmp/opencode.tar.gz ]; then \
    echo "ERROR: Failed to download OpenCode from ${OPENCODE_RELEASE_URL}"; \
    exit 1; \
    fi; \
    \
    # Verify SHA256 checksum against pinned checksums \
    OPENCODE_TARBALL="opencode-linux-${OPENCODE_ARCH}.tar.gz"; \
    OPENCODE_EXPECTED="$(grep -E "  ${OPENCODE_TARBALL}$" /etc/opencode-checksums | head -1 | awk '{print $1}')"; \
    if [ -z "${OPENCODE_EXPECTED}" ]; then \
    echo "ERROR: No checksum entry for ${OPENCODE_TARBALL} in checksums file"; \
    exit 1; \
    fi; \
    echo "Verifying SHA256 checksum for ${OPENCODE_TARBALL}..."; \
    echo "${OPENCODE_EXPECTED}  /tmp/opencode.tar.gz" | sha256sum -c -; \
    \
    # Extract to vendor bin \
    tar -xzf /tmp/opencode.tar.gz -C /vendor/bin; \
    chmod +x /vendor/bin/opencode; \
    \
    # Verify installation \
    /vendor/bin/opencode --version; \
    \
    # Cleanup \
    rm -f /tmp/opencode.tar.gz; \
    \
    echo "✓ OpenCode ${OPENCODE_VERSION} installed successfully";

# Create non-root user with HOME=/home/opencode (NOT /workspace).
# HOME=/workspace was the root cause of permission failures: bind-mounting
# a host directory to /workspace shadows the container HOME, so uid 1001
# loses write access to its own HOME. This breaks Bun JIT cache, config
# writes, and the opencode binary itself. /workspace remains WORKDIR for
# the user's project; /home/opencode holds container state (always writable).
RUN useradd -m -d /home/opencode -u 1001 -s /bin/bash opencode || useradd -m -d /home/opencode -s /bin/bash opencode

WORKDIR /workspace

# Copy configuration files
COPY --chown=opencode:opencode .opencode/ /opencode/default/
COPY etc/ /etc/
COPY --chown=opencode:opencode skills-lock.json /opencode/default/skills-lock.json
COPY --chmod=755 entrypoint.py /usr/local/bin/entrypoint.py

# Environment configuration
ENV PATH="/vendor/bin:${PATH}" \
    OPENCODE_CONFIG="/opencode/default/opencode.json" \
    OPENCODE_THEME="ayu-dark" \
    OMO_SEND_ANONYMOUS_TELEMETRY=0 \
    OMO_DISABLE_POSTHOG=1

# Numeric UID (not the symbolic "opencode") avoids hadolint DL3066 and matches
# the explicit `-u 1001` in useradd above. The name is still resolvable for
# COPY --chown because useradd already created it earlier in this stage.
USER 1001

# Install baseline skills (oh-my-openagent) from skills-lock.json
# ECC and superpowers skills are installed at runtime via entrypoint.py (opt-in)
WORKDIR /opencode/default
RUN npx --yes skills@1.5.13 experimental_install --agent opencode --copy -y
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.py"]
CMD ["/bin/bash"]
