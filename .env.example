# .env.example - opencoder Container Configuration
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# This file is safe to commit. Your actual .env is gitignored.

# =============================================================================
# Container Image
# =============================================================================

# Image tag to use (matches GHCR published tags: latest, <version>, <git-sha>)
OPENCODE_IMAGE_TAG=latest

# =============================================================================
# Provider Credentials
# =============================================================================

# ZAI Coding Plan (GLM-4.5, GLM-5.x models)
# Get your key at: https://z.ai/
ZHIPU_API_KEY=

# =============================================================================
# opencode-mem Web UI (memory explorer)
# =============================================================================

# Expose the web UI so the compose port mapping can reach it (1=expose).
# Loopback-only inside the container when 0 (default) — the port mapping
# is then a no-op.
OPENCODE_MEM_WEB_EXPOSED=0

# API token required when exposure is enabled (protects the web API).
# Generate one with: openssl rand -hex 32
OPENCODE_MEM_WEB_TOKEN=

# Host-side port for the web UI (container port is fixed at 4747)
OPENCODE_MEM_WEB_PORT=4747

# =============================================================================
# Appearance
# =============================================================================

# TUI theme (see build/.opencode/themes/ for options: ayu-dark, lavi, moonlight)
OPENCODE_THEME=ayu-dark

# =============================================================================
# Optional Skill Collections (require network at container start)
# =============================================================================

# Everything Claude Code: 16 agents, 65 skills, 40 commands
ECC_ENABLED=0

# Superpowers: TDD, debugging, git workflow skills
SUPERPOWERS_ENABLED=0

# =============================================================================
# Oh-My-OpenCode Subscription Flags
# Tell oh-my-opencode which models to add to agent fallback chains.
# These are NOT credentials - they control model availability.
# Values: yes | no (OMO_CLAUDE also accepts max20)
# =============================================================================

OMO_CLAUDE=no
OMO_GEMINI=no
OMO_COPILOT=no
OMO_OPENAI=no
OMO_OPENCODE_GO=no
OMO_OPENCODE_ZEN=no
OMO_ZAI_CODING_PLAN=no

# Force reinstallation of oh-my-opencode config (set to 'yes' to force)
OMO_FORCE=

# =============================================================================
# Bootstrap Control
# =============================================================================

# Overwrite existing config at container start (1=overwrite, 0=preserve)
OPENCODE_BOOTSTRAP_FORCE=0

# =============================================================================
# Telemetry (default: disabled)
# =============================================================================

OMO_SEND_ANONYMOUS_TELEMETRY=0
OMO_DISABLE_POSTHOG=1
